  {
   "cell_type": "code",
   "metadata": {
    "ExecuteTime": {
     "end_time": "2026-02-14T11:17:26.305238Z",
     "start_time": "2026-02-14T11:17:26.297236Z"
    }
   },
   "source": "# [셀 17] 추론 + 시각화 함수\n# 주석: 원본/GT/예측/오버레이를 같이 확인해 qualitative 분석을 합니다.\n@torch.no_grad()\ndef inference_with_tta(model, image_tensor):\n    model.eval()\n    logits = model(image_tensor)['logits']\n\n    # horizontal flip TTA\n    flip_in = torch.flip(image_tensor, dims=[3])\n    flip_logits = model(flip_in)['logits']\n    flip_logits = torch.flip(flip_logits, dims=[3])\n\n    logits = 0.5 * logits + 0.5 * flip_logits\n    pred = logits.argmax(dim=1)\n    return pred\n\n\ndef visualize_batch(model, dataset, n=4, seed=0):\n    rng = np.random.default_rng(seed)\n    idxs = rng.choice(len(dataset), size=min(n, len(dataset)), replace=False)\n\n    plt.figure(figsize=(14, 3 * len(idxs)))\n\n    for row, idx in enumerate(idxs, start=1):\n        image, mask, name = dataset[idx]\n        image_t = image.unsqueeze(0).to(DEVICE)\n        pred = inference_with_tta(model, image_t)[0].cpu().numpy()\n\n        img_np = image.permute(1, 2, 0).cpu().numpy()\n        img_np = (img_np * np.array([0.229, 0.224, 0.225]) + np.array([0.485, 0.456, 0.406]))\n        img_np = np.clip(img_np, 0, 1)\n\n        gt_rgb = CLASS_COLORS[mask.cpu().numpy()]\n        pd_rgb = CLASS_COLORS[pred]\n        overlay = (img_np * 0.6 + (pd_rgb / 255.0) * 0.4)\n\n        plt.subplot(len(idxs), 4, 4*(row-1)+1)\n        plt.imshow(img_np)\n        plt.title(f'Image\\n{name}')\n        plt.axis('off')\n\n        plt.subplot(len(idxs), 4, 4*(row-1)+2)\n        plt.imshow(gt_rgb)\n        plt.title('GT')\n        plt.axis('off')\n\n        plt.subplot(len(idxs), 4, 4*(row-1)+3)\n        plt.imshow(pd_rgb)\n        plt.title('Pred')\n        plt.axis('off')\n\n        plt.subplot(len(idxs), 4, 4*(row-1)+4)\n        plt.imshow(overlay)\n        plt.title('Overlay')\n        plt.axis('off')\n\n    plt.tight_layout()\n    plt.savefig(SAVE_DIR / 'val_predictions.png', dpi=150)\n    plt.show()",
   "id": "7fe095ea3e28c303",
   "outputs": [],
   "execution_count": 94
  },
  {
   "cell_type": "code",
   "metadata": {
    "ExecuteTime": {
