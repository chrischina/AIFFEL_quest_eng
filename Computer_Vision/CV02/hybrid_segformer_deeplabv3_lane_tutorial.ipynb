   "source": [
    "# [셀 9] Hybrid Head 구성요소: ASPP / SegFormer decode branch\n",
    "# 주석: DeepLabV3의 핵심인 ASPP와 SegFormer 스타일 멀티스케일 디코더를 구현합니다.\n",
    "class ASPP(nn.Module):\n",
    "    def __init__(self, in_ch, out_ch, rates=(1, 6, 12, 18), dropout=0.1):\n",
    "        super().__init__()\n",
    "        self.blocks = nn.ModuleList()\n",
    "        for r in rates:\n",
    "            if r == 1:\n",
    "                self.blocks.append(nn.Sequential(\n",
    "                    nn.Conv2d(in_ch, out_ch, kernel_size=1, bias=False),\n",
    "                    nn.BatchNorm2d(out_ch),\n",
    "                    nn.ReLU(inplace=True),\n",
    "                ))\n",
    "            else:\n",
    "                self.blocks.append(nn.Sequential(\n",
    "                    nn.Conv2d(in_ch, out_ch, kernel_size=3, padding=r, dilation=r, bias=False),\n",
    "                    nn.BatchNorm2d(out_ch),\n",
    "                    nn.ReLU(inplace=True),\n",
    "                ))\n",
    "\n",
    "        self.global_pool = nn.Sequential(\n",
    "            nn.AdaptiveAvgPool2d(1),\n",
    "            nn.Conv2d(in_ch, out_ch, kernel_size=1, bias=False),\n",
    "            nn.ReLU(inplace=True),\n",
    "        )\n",
    "\n",
    "        merged_ch = out_ch * (len(rates) + 1)\n",
    "        self.project = nn.Sequential(\n",
    "            nn.Conv2d(merged_ch, out_ch, kernel_size=1, bias=False),\n",
    "            nn.BatchNorm2d(out_ch),\n",
    "            nn.ReLU(inplace=True),\n",
    "            nn.Dropout(dropout),\n",
    "        )\n",
    "\n",
    "    def forward(self, x):\n",
    "        feats = [b(x) for b in self.blocks]\n",
    "        gp = self.global_pool(x)\n",
    "        gp = F.interpolate(gp, size=x.shape[-2:], mode='bilinear', align_corners=False)\n",
    "        feats.append(gp)\n",
    "        x = torch.cat(feats, dim=1)\n",
    "        return self.project(x)\n",
    "\n",
    "\n",
    "class SegFormerDecodeBranch(nn.Module):\n",
    "    def __init__(self, hidden_sizes, proj_ch=128, out_ch=128):\n",
    "        super().__init__()\n",
    "        self.projs = nn.ModuleList([\n",
    "            nn.Sequential(\n",
    "                nn.Conv2d(h, proj_ch, kernel_size=1, bias=False),\n",
    "                nn.BatchNorm2d(proj_ch),\n",
    "                nn.ReLU(inplace=True),\n",
    "            ) for h in hidden_sizes\n",
    "        ])\n",
    "        self.fuse = nn.Sequential(\n",
    "            nn.Conv2d(proj_ch * len(hidden_sizes), out_ch, kernel_size=3, padding=1, bias=False),\n",
    "            nn.BatchNorm2d(out_ch),\n",
    "            nn.ReLU(inplace=True),\n",
    "        )\n",
    "\n",
    "    def forward(self, hidden_states):\n",
    "        target_size = hidden_states[0].shape[-2:]\n",
    "        ups = []\n",
    "        for feat, proj in zip(hidden_states, self.projs):\n",
    "            x = proj(feat)\n",
    "            x = F.interpolate(x, size=target_size, mode='bilinear', align_corners=False)\n",
    "            ups.append(x)\n",
    "        x = torch.cat(ups, dim=1)\n",
    "        return self.fuse(x)\n"
   ],
