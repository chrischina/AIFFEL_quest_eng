   "source": "# [셀 2] 공통 import와 시드 고정\nimport os\nimport json\nimport random\nfrom pathlib import Path\nfrom getpass import getpass\n\nimport numpy as np\nimport cv2\nfrom PIL import Image\nfrom tqdm.auto import tqdm\nimport matplotlib.pyplot as plt\nimport matplotlib.font_manager as fm\n\nimport torch\nimport torch.nn as nn\nimport torch.nn.functional as F\nfrom torch.utils.data import Dataset, DataLoader\n\nimport albumentations as A\nfrom albumentations.pytorch import ToTensorV2\n\nfrom transformers import SegformerModel\n\nimport wandb\n\n# 한글 폰트 설정 (AppleGothic)\nplt.rcParams['font.family'] = 'AppleGothic'\nplt.rcParams['axes.unicode_minus'] = False\nfm._load_fontmanager(try_read_cache=False)\n\n# WandB 로그인: 이미 로그인 되어있으면 건너뜀\nif wandb.api.api_key is None:\n    key = getpass(\"WandB API Key를 붙여넣으세요: \")\n    wandb.login(key=key)\n    print(\"✅ WandB 로그인 성공!\")\nelse:\n    print(\"✅ WandB 이미 로그인 되어있음\")\n\nprint(\"✅ All imports loaded\")\n\n\ndef seed_everything(seed: int = 42):\n    random.seed(seed)\n    np.random.seed(seed)\n    torch.manual_seed(seed)\n    torch.cuda.manual_seed_all(seed)\n    torch.backends.cudnn.deterministic = False\n    torch.backends.cudnn.benchmark = True\n\n\nseed_everything(42)\n\n# MPS (Apple Silicon) 지원 추가\nif torch.backends.mps.is_available():\n    DEVICE = torch.device(\"mps\")\n    print(\"✅ Using MPS (Apple Silicon GPU)\")\nelif torch.cuda.is_available():\n    DEVICE = torch.device(\"cuda\")\n    print(\"✅ Using CUDA (NVIDIA GPU)\")\nelse:\n    DEVICE = torch.device(\"cpu\")\n    print(\"⚠️  Using CPU (No GPU available)\")\n\nprint(\"DEVICE:\", DEVICE)\n\n\ndef split_train_val(items, test_size=0.2, random_state=42, shuffle=True):\n    items = list(items)\n    n = len(items)\n    if n == 0:\n        return [], []\n\n    indices = np.arange(n)\n    if shuffle:\n        rng = np.random.default_rng(int(random_state))\n        rng.shuffle(indices)\n\n    n_val = int(round(n * float(test_size)))\n    n_val = max(1, min(n - 1, n_val)) if n > 1 else 1\n\n    val_idx = indices[:n_val]\n    train_idx = indices[n_val:]\n\n    train_items = [items[i] for i in train_idx]\n    val_items = [items[i] for i in val_idx]\n    return train_items, val_items",
   "id": "c3fa3f6f2e08ac09",
