   "source": [
    "# [셀 16] 학습 곡선 시각화\n",
    "# 주석: 과적합 여부와 lane 성능 추이를 한 번에 확인합니다.\n",
    "plt.figure(figsize=(14, 4))\n",
    "\n",
    "plt.subplot(1, 3, 1)\n",
    "plt.plot(history['train_loss'])\n",
    "plt.title('Train Loss')\n",
    "plt.xlabel('epoch')\n",
    "\n",
    "plt.subplot(1, 3, 2)\n",
    "plt.plot(history['val_miou_fg'], label='mIoU(fg)')\n",
    "plt.plot(history['val_miou_all'], label='mIoU(all)', alpha=0.7)\n",
    "plt.legend()\n",
    "plt.title('Validation mIoU')\n",
    "plt.xlabel('epoch')\n",
    "\n",
    "plt.subplot(1, 3, 3)\n",
    "plt.plot(history['val_lane_iou'], color='orange')\n",
    "plt.axhline(0.52, color='red', linestyle='--', label='target lane IoU 0.52')\n",
    "plt.legend()\n",
    "plt.title('Lane IoU')\n",
    "plt.xlabel('epoch')\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.savefig(SAVE_DIR / 'training_curves.png', dpi=150)\n",
    "plt.show()\n"
   ],
