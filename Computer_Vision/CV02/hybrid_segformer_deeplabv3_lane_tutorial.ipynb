    "# [셀 21-2] 실험 결과 로거\n",
    "# 주석: 각 실험 결과를 CSV에 추가해 비교표를 만듭니다.\n",
    "import csv\n",
    "from datetime import datetime\n",
    "\n",
    "LOG_CSV = SAVE_DIR / 'experiment_log.csv'\n",
    "\n",
    "def append_experiment_log(row: dict, csv_path=LOG_CSV):\n",
    "    fieldnames = [\n",
    "        'time', 'exp_id', 'seed', 'epochs', 'img_size', 'batch_size', 'lr',\n",
    "        'lane_lambda', 'dice_lambda', 'best_miou_fg', 'best_lane_iou', 'final_miou_fg', 'final_lane_iou'\n",
    "    ]\n",
    "    exists = csv_path.exists()\n",
    "    with open(csv_path, 'a', newline='') as f:\n",
    "        writer = csv.DictWriter(f, fieldnames=fieldnames)\n",
    "        if not exists:\n",
    "            writer.writeheader()\n",
    "        writer.writerow(row)\n",
    "\n",
    "print('log file:', LOG_CSV)\n"
