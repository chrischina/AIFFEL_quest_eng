   "source": "# [셀 19] 최종 지표 저장 + WandB 종료\nfinal_metrics = evaluate(model, val_loader, num_classes=CFG['num_classes'], lane_class_idx=CFG['lane_class_idx'])\n\nsummary = {\n    'best_miou_fg': float(max(history['val_miou_fg'])) if history['val_miou_fg'] else None,\n    'best_lane_iou': float(max(history['val_lane_iou'])) if history['val_lane_iou'] else None,\n    'final_miou_fg': float(final_metrics['miou_fg']),\n    'final_miou_all': float(final_metrics['miou_all']),\n    'final_lane_iou': float(final_metrics['lane_iou']),\n    'class_iou': {CLASS_NAMES[i]: float(v) for i, v in enumerate(final_metrics['class_iou'])},\n}\n\n# WandB에 클래스별 IoU 기록\nfor i, name in enumerate(CLASS_NAMES):\n    wandb.summary[f'class_iou/{name}'] = float(final_metrics['class_iou'][i])\n\n# 로컬에도 JSON 저장\nwith open(SAVE_DIR / 'metrics.json', 'w') as f:\n    json.dump(summary, f, indent=2)\n\n# WandB 종료\nwandb.finish()\n\nprint(json.dumps(summary, indent=2))\nprint(\"\\n✅ WandB run 종료! https://wandb.ai 에서 결과를 확인하세요.\")",
