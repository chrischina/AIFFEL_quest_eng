   },
   "source": [
    "# [셀 18] best 모델 로드 후 시각화 실행\n",
    "# 주석: mIoU 기준 모델과 lane IoU 기준 모델을 각각 비교해볼 수 있습니다.\n",
    "best_path = SAVE_DIR / 'best_miou_model.pth'\n",
    "if best_path.exists():\n",
    "    model.load_state_dict(torch.load(best_path, map_location=DEVICE))\n",
    "    print('Loaded:', best_path)\n",
    "\n",
    "visualize_batch(model, val_ds, n=4, seed=42)\n"
   ],
