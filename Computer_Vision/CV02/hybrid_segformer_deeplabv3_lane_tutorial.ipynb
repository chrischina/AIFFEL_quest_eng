   "source": [
    "# [셀 5] 학습/검증 파일 리스트 만들기\n",
    "# 주석: image_list.json이 있으면 그대로 쓰고, 없으면 이미지 폴더를 기준으로 생성합니다.\n",
    "image_list_path = MASK_DIR / 'image_list.json'\n",
    "if image_list_path.exists():\n",
    "    with open(image_list_path, 'r') as f:\n",
    "        all_images = json.load(f)\n",
    "else:\n",
    "    all_images = [p.name for p in IMG_DIR.glob('*.png') if '___' not in p.name]\n",
    "\n",
    "all_images = sorted(all_images)\n",
    "train_images, val_images = split_train_val(all_images, test_size=0.2, random_state=42)\n",
    "\n",
    "print('train:', len(train_images), 'val:', len(val_images))\n",
    "print('sample:', train_images[:3])\n"
   ],
