   "source": [
    "# [셀 11] Loss 함수 정의 (Weighted CE + Dice + Lane focal)\n",
    "# 주석: Lane Mark의 희소성(작은 비율)을 보완하기 위해 lane focal 항을 추가합니다.\n",
    "def compute_class_weights(mask_dir, image_names, num_classes=7):\n",
    "    hist = np.zeros(num_classes, dtype=np.float64)\n",
    "    for name in image_names:\n",
    "        m = np.array(Image.open(Path(mask_dir) / name.replace('.png', '_mask.png')).convert('L'))\n",
    "        h = np.bincount(m.reshape(-1), minlength=num_classes)\n",
    "        hist += h\n",
    "    freq = hist / (hist.sum() + 1e-8)\n",
    "    w = 1.0 / np.log(1.02 + freq)\n",
    "    w = w / w.mean()\n",
    "    return torch.tensor(w, dtype=torch.float32)\n",
    "\n",
    "\n",
    "class SoftDiceLoss(nn.Module):\n",
    "    def __init__(self, num_classes, eps=1e-6):\n",
    "        super().__init__()\n",
    "        self.num_classes = num_classes\n",
    "        self.eps = eps\n",
    "\n",
    "    def forward(self, logits, targets):\n",
    "        probs = torch.softmax(logits, dim=1)\n",
    "        onehot = F.one_hot(targets, num_classes=self.num_classes).permute(0, 3, 1, 2).float()\n",
    "\n",
    "        dims = (0, 2, 3)\n",
    "        inter = (probs * onehot).sum(dims)\n",
    "        denom = probs.sum(dims) + onehot.sum(dims)\n",
    "        dice = (2.0 * inter + self.eps) / (denom + self.eps)\n",
    "\n",
    "        # background(0) 제외 평균\n",
    "        return 1.0 - dice[1:].mean()\n",
    "\n",
    "\n",
    "class HybridLoss(nn.Module):\n",
    "    def __init__(self, class_weights, lane_class_idx=4, dice_lambda=1.0, lane_lambda=2.0, gamma=2.0):\n",
    "        super().__init__()\n",
    "        self.ce = nn.CrossEntropyLoss(weight=class_weights)\n",
    "        self.dice = SoftDiceLoss(num_classes=len(class_weights))\n",
    "        self.lane_class_idx = lane_class_idx\n",
    "        self.dice_lambda = dice_lambda\n",
    "        self.lane_lambda = lane_lambda\n",
    "        self.gamma = gamma\n",
    "\n",
    "    def forward(self, logits, targets):\n",
    "        logits = torch.nan_to_num(logits, nan=0.0, posinf=20.0, neginf=-20.0)\n",
    "\n",
    "        ce_loss = torch.nan_to_num(self.ce(logits, targets), nan=0.0, posinf=10.0, neginf=10.0)\n",
    "        dice_loss = torch.nan_to_num(self.dice(logits, targets), nan=0.0, posinf=10.0, neginf=10.0)\n",
    "\n",
    "        probs = torch.softmax(logits.float(), dim=1)[:, self.lane_class_idx].clamp(min=1e-6, max=1.0 - 1e-6)\n",
    "        lane_gt = (targets == self.lane_class_idx).float()\n",
    "\n",
    "        pt = torch.where(lane_gt > 0.5, probs, 1.0 - probs).clamp(min=1e-6, max=1.0 - 1e-6)\n",
    "        focal = -((1.0 - pt) ** self.gamma) * torch.log(pt)\n",
    "        lane_focal = torch.nan_to_num(focal.mean(), nan=0.0, posinf=10.0, neginf=10.0)\n",
    "\n",
    "        total = ce_loss + self.dice_lambda * dice_loss + self.lane_lambda * lane_focal\n",
    "        total = torch.nan_to_num(total, nan=0.0, posinf=20.0, neginf=20.0)\n",
    "\n",
    "        return total, {\n",
    "            'ce': float(ce_loss.detach().item()),\n",
    "            'dice': float(dice_loss.detach().item()),\n",
    "            'lane_focal': float(lane_focal.detach().item()),\n",
    "        }\n"
   ],
