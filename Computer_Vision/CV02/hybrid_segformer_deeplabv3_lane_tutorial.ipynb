    "assert IMG_DIR.exists(), f'IMG_DIR not found: {IMG_DIR}'\n",
    "assert MASK_DIR.exists(), f'MASK_DIR not found: {MASK_DIR}'\n",
    "\n",
    "with open(JSON_PATH, 'r') as f:\n",
