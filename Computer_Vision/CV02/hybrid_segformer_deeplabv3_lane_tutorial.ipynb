   "source": "# [셀 21-3] 반복 실행 함수 (WandB 버전)\nimport copy\n\n\ndef run_experiment(cfg_override):\n    local_cfg = copy.deepcopy(CFG)\n    local_cfg.update(cfg_override)\n    exp_id = local_cfg.get('exp_id', 'EXP')\n\n    # WandB run 시작\n    run = wandb.init(\n        project=\"motorcycle-night-ride\",\n        name=f\"{exp_id}_seed{local_cfg['seed']}\",\n        config=local_cfg,\n        reinit=True,\n    )\n\n    seed_everything(int(local_cfg['seed']))\n    tr_images, va_images = split_train_val(\n        sorted(all_images), test_size=0.2, random_state=int(local_cfg['seed'])\n    )\n\n    tr_ds = NightRideDataset(tr_images, IMG_DIR, MASK_DIR, get_train_tfms(local_cfg['img_size']))\n    va_ds = NightRideDataset(va_images, IMG_DIR, MASK_DIR, get_val_tfms(local_cfg['img_size']))\n    tr_loader = DataLoader(tr_ds, batch_size=int(local_cfg['batch_size']), shuffle=True, num_workers=0)\n    va_loader = DataLoader(va_ds, batch_size=int(local_cfg['batch_size']), shuffle=False, num_workers=0)\n\n    class_w = compute_class_weights(MASK_DIR, tr_images, num_classes=local_cfg['num_classes']).to(DEVICE)\n    model_local = HybridSegFormerDeepLabV3(\n        num_classes=local_cfg['num_classes'],\n        local_files_only=bool(local_cfg.get('local_files_only', False))\n    ).to(DEVICE)\n    criterion_local = HybridLoss(\n        class_weights=class_w,\n        lane_class_idx=local_cfg['lane_class_idx'],\n        dice_lambda=local_cfg['dice_lambda'],\n        lane_lambda=local_cfg['lane_lambda'],\n    )\n    optimizer_local = torch.optim.AdamW(model_local.parameters(), lr=local_cfg['lr'], weight_decay=local_cfg['weight_decay'])\n    scheduler_local = torch.optim.lr_scheduler.CosineAnnealingWarmRestarts(optimizer_local, T_0=10, T_mult=2)\n    scaler_local = torch.amp.GradScaler('cuda', enabled=bool(local_cfg.get('amp', False) and DEVICE.type == 'cuda'))\n\n    best_miou, best_lane, patience = -1.0, -1.0, 0\n    exp_dir = SAVE_DIR / f\"{exp_id}_seed{local_cfg['seed']}\"\n    exp_dir.mkdir(parents=True, exist_ok=True)\n\n    for epoch in range(1, int(local_cfg['epochs']) + 1):\n        train_loss = train_one_epoch(model_local, tr_loader, optimizer_local, criterion_local, scaler_local, epoch)\n        val_m = evaluate(model_local, va_loader, num_classes=local_cfg['num_classes'], lane_class_idx=local_cfg['lane_class_idx'])\n        scheduler_local.step(epoch)\n\n        wandb.log({\n            'epoch': epoch,\n            'train_loss': train_loss,\n            'val_miou_fg': val_m['miou_fg'],\n            'val_lane_iou': val_m['lane_iou'],\n            'lr': optimizer_local.param_groups[0]['lr'],\n        })\n\n        print(f\"[{exp_id}] ep={epoch:03d} loss={train_loss:.4f} miou_fg={val_m['miou_fg']:.4f} lane={val_m['lane_iou']:.4f}\")\n\n        if val_m['miou_fg'] > best_miou:\n            best_miou = val_m['miou_fg']\n            torch.save(model_local.state_dict(), exp_dir / 'best_miou_model.pth')\n            patience = 0\n        else:\n            patience += 1\n\n        if val_m['lane_iou'] > best_lane:\n            best_lane = val_m['lane_iou']\n            torch.save(model_local.state_dict(), exp_dir / 'best_lane_model.pth')\n\n        if patience >= int(local_cfg.get('early_stop_patience', 20)):\n            print(f\"[{exp_id}] early stop at epoch {epoch}\")\n            break\n\n    wandb.summary['best_miou_fg'] = best_miou\n    wandb.summary['best_lane_iou'] = best_lane\n    wandb.finish()\n\n    return {'exp_id': exp_id, 'best_miou_fg': best_miou, 'best_lane_iou': best_lane}\n\n\n# 사용 예시 1: 단일 실험\n# summary = run_experiment(EXPERIMENT_GRID[0])\n\n# 사용 예시 2: 여러 실험 순차 실행\n# for exp_cfg in EXPERIMENT_GRID:\n#     summary = run_experiment(exp_cfg)\n#     print(summary)",
