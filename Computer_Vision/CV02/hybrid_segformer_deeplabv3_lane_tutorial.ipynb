   "source": [
    "# [셀 10] Hybrid SegFormer-DeepLabV3 모델 정의\n",
    "# 주석: 동일 backbone feature로 두 branch를 만들고, logits를 fusion해서 최종 예측을 만듭니다.\n",
    "class HybridSegFormerDeepLabV3(nn.Module):\n",
    "    def __init__(self, num_classes=7, pretrained_name='nvidia/segformer-b2-finetuned-ade-512-512', local_files_only=False):\n",
    "        super().__init__()\n",
    "        try:\n",
    "            self.backbone = SegformerModel.from_pretrained(pretrained_name, local_files_only=bool(local_files_only))\n",
    "        except Exception as e:\n",
    "            if bool(local_files_only):\n",
    "                raise RuntimeError(\n",
    "                    f'Backbone not found in local cache: {pretrained_name}. '\n",
    "                    f'Disable local_files_only or pre-download the model. Original error: {e}'\n",
    "                ) from e\n",
    "            # Fallback: try cached files only to avoid long hub retries in unstable network envs.\n",
    "            self.backbone = SegformerModel.from_pretrained(pretrained_name, local_files_only=True)\n",
    "        hidden_sizes = self.backbone.config.hidden_sizes\n",
    "\n",
    "        self.segformer_branch = SegFormerDecodeBranch(hidden_sizes, proj_ch=128, out_ch=128)\n",
    "        self.segformer_classifier = nn.Conv2d(128, num_classes, kernel_size=1)\n",
    "\n",
    "        self.aspp = ASPP(in_ch=hidden_sizes[-1], out_ch=128, rates=(1, 6, 12, 18), dropout=0.1)\n",
    "        self.deeplab_classifier = nn.Sequential(\n",
    "            nn.Conv2d(128, 128, kernel_size=3, padding=1, bias=False),\n",
    "            nn.BatchNorm2d(128),\n",
    "            nn.ReLU(inplace=True),\n",
    "            nn.Conv2d(128, num_classes, kernel_size=1),\n",
    "        )\n",
    "\n",
    "        self.fusion = nn.Sequential(\n",
    "            nn.Conv2d(num_classes * 2, 128, kernel_size=3, padding=1, bias=False),\n",
    "            nn.BatchNorm2d(128),\n",
    "            nn.ReLU(inplace=True),\n",
    "            nn.Dropout(0.1),\n",
    "            nn.Conv2d(128, num_classes, kernel_size=1),\n",
    "        )\n",
    "\n",
    "        # 주석: branch별 기여도를 학습 가능한 파라미터로 둡니다.\n",
    "        self.branch_alpha = nn.Parameter(torch.tensor([0.4, 0.4, 0.2], dtype=torch.float32))\n",
    "\n",
    "    def forward(self, x):\n",
    "        out = self.backbone(pixel_values=x, output_hidden_states=True, return_dict=True)\n",
    "        hs = out.hidden_states  # [stage1, stage2, stage3, stage4]\n",
    "\n",
    "        seg_feat = self.segformer_branch(hs)\n",
    "        seg_logits = self.segformer_classifier(seg_feat)\n",
    "\n",
    "        aspp_feat = self.aspp(hs[-1])\n",
    "        aspp_feat = F.interpolate(aspp_feat, size=seg_feat.shape[-2:], mode='bilinear', align_corners=False)\n",
    "        dlv3_logits = self.deeplab_classifier(aspp_feat)\n",
    "\n",
    "        fused_logits = self.fusion(torch.cat([seg_logits, dlv3_logits], dim=1))\n",
    "\n",
    "        w = torch.softmax(self.branch_alpha, dim=0)\n",
    "        logits = w[0] * seg_logits + w[1] * dlv3_logits + w[2] * fused_logits\n",
    "        logits = F.interpolate(logits, size=x.shape[-2:], mode='bilinear', align_corners=False)\n",
    "\n",
    "        return {\n",
    "            'logits': logits,\n",
    "            'seg_logits': seg_logits,\n",
    "            'dlv3_logits': dlv3_logits,\n",
    "            'fused_logits': fused_logits,\n",
    "            'weights': w.detach(),\n",
    "        }\n"
   ],
