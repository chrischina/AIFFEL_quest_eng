   "source": "# [셀 15] 전체 학습 루프 (WandB 로깅)\n# 주석: wandb로 실험을 추적합니다. 웹 대시보드에서 실시간 확인 가능!\n\n# WandB 초기화\nwandb.init(\n    project=\"motorcycle-night-ride\",\n    name=\"hybrid-segformer-deeplabv3-baseline\",\n    config=CFG,\n)\n# wandb가 모델 구조도 추적하게 설정\nwandb.watch(model, log=\"gradients\", log_freq=50)\n\nhistory = {\n    'train_loss': [],\n    'val_miou_all': [],\n    'val_miou_fg': [],\n    'val_lane_iou': [],\n}\n\nbest_miou = -1.0\nbest_lane = -1.0\npatience = 0\n\nfor epoch in range(1, CFG['epochs'] + 1):\n    train_loss = train_one_epoch(model, train_loader, optimizer, criterion, scaler, epoch)\n    metrics = evaluate(model, val_loader, num_classes=CFG['num_classes'], lane_class_idx=CFG['lane_class_idx'])\n    scheduler.step(epoch)\n\n    if not np.isfinite(train_loss):\n        print(f'Non-finite train loss at epoch {epoch}; stopping training.')\n        break\n\n    history['train_loss'].append(train_loss)\n    history['val_miou_all'].append(metrics['miou_all'])\n    history['val_miou_fg'].append(metrics['miou_fg'])\n    history['val_lane_iou'].append(metrics['lane_iou'])\n\n    # WandB 로깅 (이 한 줄로 끝!)\n    wandb.log({\n        'epoch': epoch,\n        'train_loss': train_loss,\n        'val_miou_all': metrics['miou_all'],\n        'val_miou_fg': metrics['miou_fg'],\n        'val_lane_iou': metrics['lane_iou'],\n        'lr': optimizer.param_groups[0]['lr'],\n    })\n\n    print(\n        f\"[Epoch {epoch:03d}] \"\n        f\"loss={train_loss:.4f} \"\n        f\"mIoU(all)={metrics['miou_all']:.4f} \"\n        f\"mIoU(fg)={metrics['miou_fg']:.4f} \"\n        f\"laneIoU={metrics['lane_iou']:.4f}\"\n    )\n\n    # best mIoU 저장\n    if metrics['miou_fg'] > best_miou:\n        best_miou = metrics['miou_fg']\n        torch.save(model.state_dict(), SAVE_DIR / 'best_miou_model.pth')\n        patience = 0\n    else:\n        patience += 1\n\n    # best lane IoU 저장\n    if metrics['lane_iou'] > best_lane:\n        best_lane = metrics['lane_iou']\n        torch.save(model.state_dict(), SAVE_DIR / 'best_lane_model.pth')\n\n    if patience >= CFG['early_stop_patience']:\n        print(f'Early stopping triggered at epoch {epoch}')\n        break\n\n# WandB에 최종 결과 기록\nwandb.summary['best_miou_fg'] = best_miou\nwandb.summary['best_lane_iou'] = best_lane\n\nprint('best mIoU(fg):', best_miou)\nprint('best lane IoU:', best_lane)",
