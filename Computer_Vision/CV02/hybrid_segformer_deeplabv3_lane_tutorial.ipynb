   "source": "# [셀 3] 경로/하이퍼파라미터 설정\n# 주석: 본인 환경에 맞게 BASE_DIR만 먼저 확인하세요.\nBASE_DIR = Path('/Users/changilkimm3/AiffelCode/CV/Motorcycle_Night_ride')\nDATA_DIR = BASE_DIR / 'dataset'\nJSON_PATH = DATA_DIR / 'COCO_motorcycle (pixel).json'\nIMG_DIR = DATA_DIR / 'images'\nMASK_DIR = DATA_DIR / 'masks'\nSAVE_DIR = BASE_DIR / 'results_hybrid_segformer_deeplabv3'\nSAVE_DIR.mkdir(parents=True, exist_ok=True)\n\nCFG = {\n    'img_size': 512,\n    'batch_size': 2,\n    'num_workers': 0,\n    'epochs': 80,\n    'lr': 1e-4,\n    'weight_decay': 1e-2,\n    'amp': False,\n    'num_classes': 7,\n    'local_files_only': False,\n    'lane_class_idx': 4,\n    'lane_lambda': 2.0,\n    'dice_lambda': 1.0,\n    'max_grad_norm': 1.0,\n    'early_stop_patience': 20,\n}\n\nCLASS_NAMES = ['Background', 'Rider', 'My bike', 'Moveable', 'Lane Mark', 'Road', 'Undrivable']\nCLASS_COLORS = np.array([\n    [0, 0, 0],\n    [255, 0, 0],\n    [0, 255, 0],\n    [0, 0, 255],\n    [255, 255, 0],\n    [128, 128, 128],\n    [255, 128, 0],\n], dtype=np.uint8)\n\nprint('save dir:', SAVE_DIR)",
