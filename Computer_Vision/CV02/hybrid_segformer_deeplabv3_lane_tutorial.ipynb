   "source": [
    "# [셀 6] augmentation 정의\n",
    "# 주석: lane 같은 얇은 구조를 살리기 위해 resize 후 다양한 밝기/기하 변환을 사용합니다.\n",
    "def get_train_tfms(size=512):\n",
    "    return A.Compose([\n",
    "        A.Resize(size, size),\n",
    "        A.HorizontalFlip(p=0.5),\n",
    "        A.ShiftScaleRotate(\n",
    "            shift_limit=0.08,\n",
    "            scale_limit=0.15,\n",
    "            rotate_limit=12,\n",
    "            border_mode=cv2.BORDER_CONSTANT,\n",
    "            p=0.5,\n",
    "        ),\n",
    "        A.RandomBrightnessContrast(0.25, 0.25, p=0.5),\n",
    "        A.CLAHE(clip_limit=4.0, p=0.25),\n",
    "        A.GaussianBlur(blur_limit=(3, 5), p=0.2),\n",
    "        A.Normalize(mean=(0.485, 0.456, 0.406), std=(0.229, 0.224, 0.225)),\n",
    "        ToTensorV2(),\n",
    "    ])\n",
    "\n",
    "\n",
    "def get_val_tfms(size=512):\n",
    "    return A.Compose([\n",
    "        A.Resize(size, size),\n",
    "        A.Normalize(mean=(0.485, 0.456, 0.406), std=(0.229, 0.224, 0.225)),\n",
    "        ToTensorV2(),\n",
    "    ])\n"
   ],
   "id": "8462e8a47d9ec0fe",
   "outputs": [],
   "execution_count": 83
  },
  {
   "cell_type": "code",
   "metadata": {
    "ExecuteTime": {
     "end_time": "2026-02-14T10:06:51.620312Z",
     "start_time": "2026-02-14T10:06:51.603768Z"
    }
   },
   "source": [
    "# [셀 7] Dataset / DataLoader 정의\n",
    "# 주석: 마스크는 0~6 정수 라벨 그대로 사용합니다.\n",
    "class NightRideDataset(Dataset):\n",
    "    def __init__(self, image_names, img_dir, mask_dir, transform=None):\n",
    "        self.image_names = image_names\n",
    "        self.img_dir = Path(img_dir)\n",
    "        self.mask_dir = Path(mask_dir)\n",
    "        self.transform = transform\n",
    "\n",
    "    def __len__(self):\n",
    "        return len(self.image_names)\n",
    "\n",
    "    def __getitem__(self, idx):\n",
    "        name = self.image_names[idx]\n",
    "        img_path = self.img_dir / name\n",
    "        mask_path = self.mask_dir / name.replace('.png', '_mask.png')\n",
    "\n",
    "        image = np.array(Image.open(img_path).convert('RGB'))\n",
    "        mask = np.array(Image.open(mask_path).convert('L'), dtype=np.int64)\n",
    "\n",
    "        if self.transform is not None:\n",
    "            out = self.transform(image=image, mask=mask)\n",
    "            image = out['image']\n",
    "            mask = out['mask'].long()\n",
    "\n",
    "        return image, mask, name\n",
    "\n",
    "\n",
    "train_ds = NightRideDataset(train_images, IMG_DIR, MASK_DIR, get_train_tfms(CFG['img_size']))\n",
    "val_ds = NightRideDataset(val_images, IMG_DIR, MASK_DIR, get_val_tfms(CFG['img_size']))\n",
    "\n",
    "train_loader = DataLoader(\n",
    "    train_ds,\n",
    "    batch_size=CFG['batch_size'],\n",
    "    shuffle=True,\n",
    "    num_workers=int(CFG.get('num_workers', 0)),\n",
    "    pin_memory=(DEVICE.type == 'cuda'),\n",
    ")\n",
    "val_loader = DataLoader(\n",
    "    val_ds,\n",
    "    batch_size=CFG['batch_size'],\n",
    "    shuffle=False,\n",
    "    num_workers=int(CFG.get('num_workers', 0)),\n",
    "    pin_memory=(DEVICE.type == 'cuda'),\n",
    ")\n",
    "\n",
    "print('train steps:', len(train_loader), 'val steps:', len(val_loader))\n"
   ],
