  {
   "cell_type": "code",
   "metadata": {
    "ExecuteTime": {
     "end_time": "2026-02-14T10:07:25.388201Z",
     "start_time": "2026-02-14T10:07:25.382260Z"
    }
   },
   "source": "# [셀 12] 평가 지표(mIoU, 클래스별 IoU, lane IoU)\n# 주석: confusion matrix 기반으로 robust하게 계산합니다.\n@torch.no_grad()\ndef evaluate(model, loader, num_classes=7, lane_class_idx=4):\n    model.eval()\n    conf = torch.zeros((num_classes, num_classes), dtype=torch.float32, device=DEVICE)\n\n    for images, masks, _ in loader:\n        images = images.to(DEVICE, non_blocking=True)\n        masks = masks.to(DEVICE, non_blocking=True)\n\n        out = model(images)\n        preds = out['logits'].argmax(dim=1)\n\n        gt = masks.view(-1)\n        pd = preds.view(-1)\n        k = (gt >= 0) & (gt < num_classes)\n        inds = num_classes * gt[k] + pd[k]\n        conf += torch.bincount(inds, minlength=num_classes**2).reshape(num_classes, num_classes).float()\n\n    iou = conf.diag() / (conf.sum(1) + conf.sum(0) - conf.diag() + 1e-8)\n    miou_all = iou.mean().item()\n    miou_fg = iou[1:].mean().item()\n    lane_iou = iou[lane_class_idx].item()\n\n    return {\n        'miou_all': miou_all,\n        'miou_fg': miou_fg,\n        'lane_iou': lane_iou,\n        'class_iou': iou.detach().cpu().numpy(),\n    }",
